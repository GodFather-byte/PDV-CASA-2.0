<Project Sdk="Microsoft.NET.Sdk">
  <!-- Central WB (fornecedor) para Windows: WinForms + WebView2 sobre o .NET Framework 4.8, que já vem no Windows 10/11
       (o executável fica pequeno e não precisa instalar .NET). Montado no GitHub (windows-latest). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>CentralWB</AssemblyName>
    <RootNamespace>CentralWB</RootNamespace>
    <ApplicationIcon>CentralWB.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <Version>1.0.0</Version>
    <Company>WB Sistemas</Company>
    <Product>Central WB</Product>
    <Description>Central do fornecedor WillPDV</Description>
    <Copyright>WB Sistemas</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="CentralWB.ico" />
  </ItemGroup>
</Project>
